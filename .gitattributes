# Ignore files for distribution archives. OpenSSF Scorecard reads the
# repository from this archive, so '.github', 'renovate.json' and 'tests'
# stay in it.

/.editorconfig   export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/logo.svg        export-ignore
/screenshot.png  export-ignore
/.npmignore      export-ignore
